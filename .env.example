# Copy this to .env on the EC2 instance and fill in real values.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-django-secret-key

# Use your EC2 public IP or domain, comma-separated if you have both.
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
FRONTEND_URL=https://example.com/login

# Enable these only after HTTPS is configured for the site.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

DB_NAME=postgres
DB_USER=postgres.rxbvvdvoawwwvsrdaiyp
DB_PASSWORD=replace-with-database-password
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

BREVO_API_KEY=replace-with-brevo-api-key
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner Name
SENDER_EMAIL=no-reply@example.com
DEBUG_EMAIL=False
